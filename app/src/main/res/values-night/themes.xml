<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Night variant of the base application theme. Compose AcklineTheme
         supplies the actual dark palette; this only handles system-bar
         color/icon appearance over the dark Ackline surfaces (light icons).
         Transparent bars let the Compose surface show through. -->
    <style name="Theme.Ackline" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- System bars: transparent, Compose draws underneath. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Dark mode: light system-bar icons. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>