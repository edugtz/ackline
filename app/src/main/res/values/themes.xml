<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (light). The Compose AcklineTheme provides the
         actual light/dark palette; these platform-theme items only control
         system-bar colors/icon appearance so they match the light Ackline
         surfaces (dark status/navigation icons on light backgrounds).
         Transparent bars let the Compose surface show through. -->
    <style name="Theme.Ackline" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- System bars: transparent, Compose draws underneath. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Light mode: dark system-bar icons. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>